# Global
LOG_LEVEL=INFO
INTERNAL_HTTP_TIMEOUT=60

# Backend
ALLOWED_ORIGINS=*
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/agrismart
UPLOAD_ROOT=/app/Backend/static/uploads
YOLO_SERVICE_URL=http://yolo-service:8001
CHATBOT_SERVICE_URL=http://chatbot-service:8002
MODEL_DIR=/app/models
ENABLE_LOCAL_YOLO_FALLBACK=true
ENABLE_LOCAL_CHATBOT_FALLBACK=true

# YOLO service
YOLO_SERVICE_PORT=8001

# Chatbot service
CHATBOT_SERVICE_PORT=8002
CHATBOT_MAX_SESSIONS=150
CHATBOT_MODULE_PATH=/app/Backend/chatbot/chatbot.py
DVC_PULL_ON_STARTUP=true

# --- MLOps (DagsHub + MLflow) — training / ingest only; keep disabled in inference pods ---
# Copy to .env (never commit .env). Use Kubernetes Secrets for cluster-side values.
MLFLOW_TRACKING_ENABLED=0
# MLFLOW_HTTP_REQUEST_TIMEOUT=45
# DagsHub repo: https://dagshub.com/<DAGSHUB_USERNAME>/<DAGSHUB_REPO_NAME>
DAGSHUB_USERNAME=mfaisal4355
DAGSHUB_TOKEN=b5c4ebfa19010167bf3c9d0e2f02281e2b4fc10e
DAGSHUB_REPO_NAME=AgriSmart
# Optional alias if owner differs from account username
# DAGSHUB_REPO_OWNER=mfaisal4355
# Dataset lineage (optional; e.g. git sha for data or DVC lock revision)
# DVC_DATASET_REV=
# DVC_ARTIFACT_REF=
# AGRISMART_MODEL_VERSION=

# Optional: log a run when rebuilding the vector store (requires mlflow+dagshub in environment)
# MLFLOW_TRACK_CHATBOT_INGEST=0
# MLFLOW_CHATBOT_EXPERIMENT=agrismart-chatbot
