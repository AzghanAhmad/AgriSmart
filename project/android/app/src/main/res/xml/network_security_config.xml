<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev / LAN: allow HTTP to any host (Flask on local network). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
